# Viewerから見た経路APIのURL。未指定時は <VIEWER_BASE_PATH>api/v1/routes を利用します。
# 別オリジンまたはサイトルートのAPIへ接続する場合だけ指定してください。
# VITE_ROUTE_API_URL=https://example.com/api/v1/routes

# 道路辺APIは通常、上記URLの末尾 routes を road-edges に置換して自動決定します。
# APIが隣接していない構成の場合だけ指定してください。
# VITE_ROAD_EDGE_API_URL=https://example.com/api/v1/road-edges
