{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.pit-creation.com/schemas/pedestrian-road-network-1.0.schema.json",
  "title": "Pedestrian road network v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "areaId",
    "generatedAt",
    "graphFingerprintSha256",
    "extent",
    "coordinateSystems",
    "walking",
    "nodes",
    "edges"
  ],
  "properties": {
    "schemaVersion": { "const": "pedestrian-road-network-1.0" },
    "areaId": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "graphFingerprintSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "extent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["center", "radiusMeters"],
      "properties": {
        "center": { "$ref": "#/$defs/coordinate" },
        "radiusMeters": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "coordinateSystems": { "type": "object" },
    "walking": { "type": "object" },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "osmNodeId", "coordinate"],
        "properties": {
          "id": { "type": "string", "pattern": "^osm-node-[0-9]+$" },
          "osmNodeId": { "type": "integer", "minimum": 1 },
          "coordinate": { "$ref": "#/$defs/coordinate" }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "physicalEdgeId",
          "sourceEdgeIds",
          "osmWayIds",
          "highways",
          "fromNodeId",
          "toNodeId",
          "direction",
          "coordinates",
          "lengthMeters",
          "walkingSeconds"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "physicalEdgeId": { "type": "string", "minLength": 1 },
          "sourceEdgeIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "osmWayIds": { "type": "array", "minItems": 1, "items": { "type": "integer" } },
          "highways": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "fromNodeId": { "type": "string" },
          "toNodeId": { "type": "string" },
          "direction": { "enum": ["forward", "backward"] },
          "coordinates": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "$ref": "#/$defs/coordinate" }
          },
          "lengthMeters": { "type": "number", "exclusiveMinimum": 0 },
          "walkingSeconds": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    }
  },
  "$defs": {
    "coordinate": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 }
      ],
      "items": false
    }
  }
}
