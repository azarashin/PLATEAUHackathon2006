{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.pit-creation.com/schemas/environment-cost-pedestrian-network-2.0.schema.json",
  "title": "Environment cost sidewalk pedestrian network v2",
  "type": "object",
  "required": ["schemaVersion", "areaId", "generatedAt", "graphFingerprintSha256", "quality", "extent", "coordinateReferenceSystem", "nodes", "physicalEdges", "edges"],
  "properties": {
    "schemaVersion": { "const": "environment-cost-pedestrian-network-2.0" },
    "areaId": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "graphFingerprintSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "quality": { "type": "object", "required": ["qualityContractVersion", "status", "explicitOrDerivedRatio", "fallbackRatio", "sourceSchemaVersion", "validationFailures", "validationWarnings"], "properties": { "qualityContractVersion": { "const": "pedestrian-network-safety-1.0" }, "status": { "enum": ["accepted", "rejected", "unverified"] }, "explicitOrDerivedRatio": { "type": "number", "minimum": 0, "maximum": 1 }, "fallbackRatio": { "type": "number", "minimum": 0, "maximum": 1 }, "sourceSchemaVersion": { "type": "string" }, "validationFailures": { "type": "array", "items": { "type": "string" } }, "validationWarnings": { "type": "array", "items": { "type": "string" } } } },
    "extent": { "type": "object", "required": ["center", "radiusMeters"] },
    "coordinateReferenceSystem": { "type": "object", "required": ["geographic", "projected"] },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "physicalEdges": { "type": "array", "items": { "$ref": "#/$defs/physicalEdge" } },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/directedEdge" } }
  },
  "$defs": {
    "source": { "type": "object", "required": ["confidence", "rationale"], "properties": { "confidence": { "enum": ["explicit", "derived", "fallback"] }, "rationale": { "enum": ["explicit-pedestrian-facility", "explicit-crossing", "derived-sidewalk", "shared-space-representative-line"] } } },
    "node": { "type": "object", "required": ["id", "coordinate", "zLevel", "kind", "source"], "properties": { "source": { "$ref": "#/$defs/source" } } },
    "physicalEdge": { "type": "object", "required": ["id", "fromNodeId", "toNodeId", "geometry", "lengthMeters", "walkingSeconds", "walkability", "facility", "side", "level", "source", "fallback"], "properties": { "source": { "$ref": "#/$defs/source" } } },
    "directedEdge": { "type": "object", "required": ["id", "physicalEdgeId", "fromNodeId", "toNodeId", "walkingSeconds", "walkability", "facility", "side", "level", "source", "fallback"], "properties": { "source": { "$ref": "#/$defs/source" } } }
  }
}
