.runtime-ui-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.runtime-ui-surface {
    flex-direction: column;
    align-items: flex-start;
    padding-left: 16px;
    padding-top: 16px;
    width: 500px;
}

.runtime-overview-map-launcher {
    position: absolute;
    right: 16px;
    top: 16px;
}

.runtime-overview-map-toggle {
    background-color: rgb(219, 234, 254);
    color: rgb(30, 64, 175);
    border-left-color: rgb(147, 197, 253);
    border-right-color: rgb(147, 197, 253);
    border-top-color: rgb(147, 197, 253);
    border-bottom-color: rgb(147, 197, 253);
}

.runtime-overview-map {
    position: absolute;
    right: 16px;
    top: 52px;
    width: 276px;
    padding: 8px;
    background-color: rgba(248, 250, 252, 0.96);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(37, 99, 235);
    border-right-color: rgb(37, 99, 235);
    border-top-color: rgb(37, 99, 235);
    border-bottom-color: rgb(37, 99, 235);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.runtime-overview-map-title { color: rgb(15, 71, 125); font-size: 11px; unity-font-style: bold; margin-bottom: 4px; }
.runtime-overview-map-image { width: 260px; height: 260px; background-color: rgb(226, 232, 240); }

.runtime-tabs { flex-direction: row; margin-bottom: 8px; gap: 4px; }
.runtime-tab { background-color: rgb(219, 234, 254); color: rgb(30, 64, 175); border-left-color: rgb(147, 197, 253); border-right-color: rgb(147, 197, 253); border-top-color: rgb(147, 197, 253); border-bottom-color: rgb(147, 197, 253); }
.runtime-tab.runtime-tab-active { background-color: rgb(37, 99, 235); color: rgb(255, 255, 255); }
.runtime-tab-content { width: 500px; }

.runtime-panel {
    background-color: rgba(248, 250, 252, 0.96);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(37, 99, 235);
    border-right-color: rgb(37, 99, 235);
    border-top-color: rgb(37, 99, 235);
    border-bottom-color: rgb(37, 99, 235);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    color: rgb(15, 23, 42);
    margin-bottom: 18px;
    padding: 10px 12px 24px 12px;
    width: 480px;
    flex-shrink: 0;
}

.runtime-panel-title { color: rgb(15, 71, 125); font-size: 14px; unity-font-style: bold; margin-bottom: 4px; }
.runtime-status { color: rgb(51, 65, 85); font-size: 11px; white-space: normal; margin-top: 8px; }
.runtime-scroll { max-height: 504px; }
.runtime-row { flex-direction: row; gap: 6px; }
.runtime-panel Label { color: rgb(30, 41, 59); -unity-font-style: normal; font-size: 11px; }
.runtime-panel TextField, .runtime-panel Slider, .runtime-panel SliderInt, .runtime-panel Toggle { margin-top: 2px; margin-bottom: 2px; }
.runtime-panel .unity-base-field__label { min-width: 145px; }
.runtime-panel .unity-text-field { max-width: 390px; min-height: 25px; }
.runtime-panel .unity-text-field__input { color: rgb(15, 23, 42); background-color: rgb(255, 255, 255); border-left-color: rgb(148, 163, 184); border-right-color: rgb(148, 163, 184); border-top-color: rgb(148, 163, 184); border-bottom-color: rgb(148, 163, 184); min-height: 22px; padding-top: 2px; padding-bottom: 2px; }
.runtime-panel .unity-button { color: rgb(255, 255, 255); background-color: rgb(13, 148, 136); border-left-color: rgb(15, 118, 110); border-right-color: rgb(15, 118, 110); border-top-color: rgb(15, 118, 110); border-bottom-color: rgb(15, 118, 110); }
.runtime-panel .unity-button:hover { background-color: rgb(5, 150, 105); }
.runtime-panel .unity-button:active { background-color: rgb(4, 120, 87); }
.runtime-panel .runtime-button-danger { background-color: rgb(220, 38, 38); border-left-color: rgb(185, 28, 28); border-right-color: rgb(185, 28, 28); border-top-color: rgb(185, 28, 28); border-bottom-color: rgb(185, 28, 28); }
.runtime-panel .runtime-button-danger:hover { background-color: rgb(185, 28, 28); }
.runtime-panel .runtime-button-danger:active { background-color: rgb(153, 27, 27); }
.runtime-panel .unity-slider__tracker { background-color: rgb(191, 219, 254); }
.runtime-panel .unity-slider__dragger { background-color: rgb(37, 99, 235); }
