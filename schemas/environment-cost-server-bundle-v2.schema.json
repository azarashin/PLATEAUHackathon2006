{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.pit-creation.com/schemas/environment-cost-server-bundle-v2.schema.json",
  "title": "Environment cost server bundle manifest v2",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "status", "dataset", "inputs", "area", "scenario", "networkQuality", "counts", "topology", "costSlices", "bundleFingerprintSha256"],
  "properties": {
    "schemaVersion": { "const": "environment-cost-server-bundle-2.0" }, "status": { "const": "completed" },
    "dataset": { "type": "object", "required": ["id", "provenance", "generatedAt"], "properties": { "id": { "type": "string" }, "provenance": { "type": "string" }, "generatedAt": { "type": "string" } } },
    "inputs": { "type": "object", "required": ["roadGraphFingerprintSha256", "environmentCostFingerprintSha256"], "properties": { "roadGraphFingerprintSha256": { "$ref": "#/$defs/sha256" }, "environmentCostFingerprintSha256": { "$ref": "#/$defs/sha256" } } },
    "area": { "type": "object", "required": ["areaId", "center", "radiusMeters"], "properties": { "areaId": { "type": "string" }, "center": { "type": "array" }, "radiusMeters": { "type": "number" } } },
    "scenario": { "type": "object", "required": ["referenceDate", "timezone", "availableTimestamps", "defaultTimestamp"], "properties": { "referenceDate": { "type": "string" }, "timezone": { "type": "string" }, "availableTimestamps": { "type": "array" }, "defaultTimestamp": { "type": "string" } } },
    "networkQuality": { "type": "object", "required": ["status", "explicitOrDerivedRatio", "fallbackRatio", "sourceSchemaVersion"], "properties": { "status": { "type": "string" }, "explicitOrDerivedRatio": { "type": "number" }, "fallbackRatio": { "type": "number" }, "sourceSchemaVersion": { "type": "string" } } },
    "counts": { "type": "object", "required": ["nodeCount", "physicalEdgeCount", "directedEdgeCount", "hourCount"], "properties": { "nodeCount": { "type": "integer" }, "physicalEdgeCount": { "type": "integer" }, "directedEdgeCount": { "type": "integer" }, "hourCount": { "type": "integer" } } },
    "policyScenario": { "type": "object" }, "costFormula": { "type": "object" }, "encoding": { "type": "object" }, "diagnostics": { "type": "object" },
    "topology": { "$ref": "#/$defs/file" }, "costSlices": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/file" } },
    "bundleFingerprintSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "file": { "type": "object", "required": ["file", "bytes", "fileSha256", "contentFingerprintSha256"], "properties": { "file": { "type": "string", "minLength": 1 }, "bytes": { "type": "integer", "minimum": 1 }, "fileSha256": { "$ref": "#/$defs/sha256" }, "contentFingerprintSha256": { "$ref": "#/$defs/sha256" } } } }
}
