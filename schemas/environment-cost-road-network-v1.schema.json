{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.pit-creation.com/schemas/environment-cost-road-network-v1.schema.json",
  "title": "Environment cost road network v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "dataset",
    "area",
    "coordinateReferenceSystem",
    "scenario",
    "costDefinitions",
    "nodes",
    "edges",
    "extensions"
  ],
  "properties": {
    "schemaVersion": { "const": "environment-cost-road-network-1.0" },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "provenance", "generatedAt", "notice"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "name": { "type": "string", "minLength": 1 },
        "provenance": { "enum": ["fixture", "analysis"] },
        "generatedAt": { "type": "string", "format": "date-time" },
        "notice": { "type": "string", "minLength": 1 },
        "contentFingerprintSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "area": {
      "type": "object",
      "additionalProperties": false,
      "required": ["areaId", "center", "radiusMeters", "bbox"],
      "properties": {
        "areaId": { "$ref": "#/$defs/stableId" },
        "center": { "$ref": "#/$defs/coordinate" },
        "radiusMeters": { "type": "number", "exclusiveMinimum": 0 },
        "bbox": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            { "type": "number", "minimum": -180, "maximum": 180 },
            { "type": "number", "minimum": -90, "maximum": 90 },
            { "type": "number", "minimum": -180, "maximum": 180 },
            { "type": "number", "minimum": -90, "maximum": 90 }
          ],
          "items": false
        }
      }
    },
    "coordinateReferenceSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["geometryEpsg", "axisOrder", "unity"],
      "properties": {
        "geometryEpsg": { "const": 4326 },
        "axisOrder": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [{ "const": "longitude" }, { "const": "latitude" }],
          "items": false
        },
        "unity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["projectedEpsg", "coordinateZoneId", "axisConvention", "referencePointGeographic"],
          "properties": {
            "projectedEpsg": { "type": "integer", "minimum": 6669, "maximum": 6687 },
            "coordinateZoneId": { "type": "integer", "minimum": 1, "maximum": 19 },
            "axisConvention": { "const": "EUN" },
            "referencePointGeographic": { "$ref": "#/$defs/coordinate" }
          }
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "referenceDate", "timezone", "availableTimestamps", "defaultTimestamp", "timeSelectionPolicy"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "referenceDate": { "type": "string", "format": "date" },
        "timezone": { "type": "string", "minLength": 1 },
        "availableTimestamps": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "format": "date-time" }
        },
        "defaultTimestamp": { "type": "string", "format": "date-time" },
        "timeSelectionPolicy": { "const": "nearest-on-reference-date-ties-earlier" }
      }
    },
    "costDefinitions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/costDefinition" }
    },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/edge" }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "coordinate": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 }
      ],
      "items": false
    },
    "colorStop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "color", "label"],
      "properties": {
        "value": { "type": "number" },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "costDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "description",
        "unit",
        "range",
        "valueDirection",
        "routeAggregation",
        "missingValuePolicy",
        "presentation"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "displayName": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "minLength": 1 },
        "range": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "number" },
            "max": { "type": "number" }
          }
        },
        "valueDirection": { "enum": ["higher-is-better", "higher-is-worse"] },
        "routeAggregation": { "enum": ["sum", "maximum", "walking-time-weighted-mean"] },
        "missingValuePolicy": { "const": "preserve-null" },
        "presentation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["viewerMode", "displayUnit", "displayScale", "valueDirectionLabel", "sampleKpiLabel", "colors"],
          "properties": {
            "viewerMode": { "type": "boolean" },
            "displayUnit": { "type": "string" },
            "displayScale": { "type": "number", "exclusiveMinimum": 0 },
            "valueDirectionLabel": { "type": "string", "minLength": 1 },
            "sampleKpiLabel": { "type": "string", "minLength": 1 },
            "colors": {
              "type": "array",
              "minItems": 2,
              "items": { "$ref": "#/$defs/colorStop" }
            }
          }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "coordinate"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "coordinate": { "$ref": "#/$defs/coordinate" },
        "sourceNodeId": { "anyOf": [{ "type": "string" }, { "type": "integer" }] }
      }
    },
    "sampleCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sampleCount", "validSampleCount", "noGroundSampleCount"],
      "properties": {
        "sampleCount": { "type": "integer", "minimum": 0 },
        "validSampleCount": { "type": "integer", "minimum": 0 },
        "noGroundSampleCount": { "type": "integer", "minimum": 0 }
      }
    },
    "timeSlice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestamp", "status", "sampleCoverage", "values"],
      "properties": {
        "timestamp": { "type": "string", "format": "date-time" },
        "status": { "enum": ["available", "partial", "missing"] },
        "sampleCoverage": { "$ref": "#/$defs/sampleCoverage" },
        "values": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "anyOf": [{ "type": "number" }, { "type": "null" }] }
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "physicalEdgeId",
        "sourceEdgeIds",
        "fromNodeId",
        "toNodeId",
        "direction",
        "geometry",
        "lengthMeters",
        "walkingSeconds",
        "timeSlices"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "physicalEdgeId": { "$ref": "#/$defs/stableId" },
        "sourceEdgeIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableId" }
        },
        "fromNodeId": { "$ref": "#/$defs/stableId" },
        "toNodeId": { "$ref": "#/$defs/stableId" },
        "direction": { "enum": ["forward", "backward"] },
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "coordinates"],
          "properties": {
            "type": { "const": "LineString" },
            "coordinates": {
              "type": "array",
              "minItems": 2,
              "items": { "$ref": "#/$defs/coordinate" }
            }
          }
        },
        "lengthMeters": { "type": "number", "exclusiveMinimum": 0 },
        "walkingSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "timeSlices": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/timeSlice" }
        }
      }
    }
  }
}
