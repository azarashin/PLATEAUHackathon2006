{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.pit-creation.com/schemas/environment-cost-server-topology-v1.schema.json",
  "title": "Environment cost server topology v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "areaId", "graphFingerprintSha256", "coordinateReferenceSystem", "counts", "nodes", "physicalEdges", "directedEdges", "contentFingerprintSha256"],
  "properties": {
    "schemaVersion": { "const": "environment-cost-server-topology-1.0" },
    "areaId": { "type": "string", "minLength": 1 },
    "graphFingerprintSha256": { "$ref": "#/$defs/sha256" },
    "coordinateReferenceSystem": { "type": "object" },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeCount", "physicalEdgeCount", "directedEdgeCount"],
      "properties": {
        "nodeCount": { "type": "integer", "minimum": 2 },
        "physicalEdgeCount": { "type": "integer", "minimum": 1 },
        "directedEdgeCount": { "type": "integer", "minimum": 1 }
      }
    },
    "nodes": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/node" } },
    "physicalEdges": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/physicalEdge" } },
    "directedEdges": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/directedEdge" } },
    "contentFingerprintSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "node": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "prefixItems": [
        { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 }
      ],
      "items": false
    },
    "physicalEdge": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "prefixItems": [
        { "type": "string", "minLength": 1 },
        { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      ],
      "items": false
    },
    "directedEdge": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "prefixItems": [
        { "type": "integer", "minimum": 0 },
        { "type": "integer", "minimum": 0 },
        { "type": "integer", "minimum": 0 },
        { "enum": [0, 1] },
        { "type": "number", "exclusiveMinimum": 0 },
        { "type": "number", "exclusiveMinimum": 0 }
      ],
      "items": false
    }
  }
}
