{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.pit-creation.com/schemas/environment-cost-server-topology-v2.schema.json",
  "title": "Environment cost server topology v2",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "areaId", "graphFingerprintSha256", "networkQuality", "nodes", "physicalEdges", "directedEdges", "contentFingerprintSha256"],
  "properties": {
    "schemaVersion": { "const": "environment-cost-server-topology-2.0" }, "areaId": { "type": "string", "minLength": 1 },
    "graphFingerprintSha256": { "$ref": "#/$defs/sha256" }, "networkQuality": { "type": "object" },
    "nodes": { "type": "array", "minItems": 2 }, "physicalEdges": { "type": "array", "minItems": 1 }, "directedEdges": { "type": "array", "minItems": 1 },
    "contentFingerprintSha256": { "$ref": "#/$defs/sha256" }
  }, "$defs": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
