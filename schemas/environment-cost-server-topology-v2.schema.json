{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.pit-creation.com/schemas/environment-cost-server-topology-v2.schema.json",
  "title": "Environment cost server topology v2",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "areaId", "graphFingerprintSha256", "coordinateReferenceSystem", "networkQuality", "counts", "nodes", "physicalEdges", "directedEdges", "contentFingerprintSha256"],
  "properties": {
    "schemaVersion": { "const": "environment-cost-server-topology-2.0" }, "areaId": { "type": "string", "minLength": 1 },
    "graphFingerprintSha256": { "$ref": "#/$defs/sha256" }, "coordinateReferenceSystem": { "type": "object" },
    "networkQuality": { "$ref": "#/$defs/networkQuality" },
    "counts": { "type": "object", "additionalProperties": false, "required": ["nodeCount", "physicalEdgeCount", "directedEdgeCount"], "properties": { "nodeCount": { "type": "integer", "minimum": 2 }, "physicalEdgeCount": { "type": "integer", "minimum": 1 }, "directedEdgeCount": { "type": "integer", "minimum": 1 } } },
    "nodes": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/node" } }, "physicalEdges": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/physicalEdge" } }, "directedEdges": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/directedEdge" } }, "contentFingerprintSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "networkQuality": { "type": "object", "additionalProperties": false, "required": ["qualityContractVersion", "status", "explicitOrDerivedRatio", "fallbackRatio", "sourceSchemaVersion", "validationFailures", "validationWarnings"], "properties": { "qualityContractVersion": { "const": "pedestrian-network-safety-1.0" }, "status": { "const": "accepted" }, "explicitOrDerivedRatio": { "type": "number", "minimum": 0, "maximum": 1 }, "fallbackRatio": { "type": "number", "minimum": 0, "maximum": 1 }, "sourceSchemaVersion": { "const": "0.2" }, "validationFailures": { "type": "array", "maxItems": 0, "items": { "type": "string" } }, "validationWarnings": { "type": "array", "items": { "type": "string" } } } },
    "node": { "type": "array", "minItems": 3, "maxItems": 3, "prefixItems": [{ "type": "string", "minLength": 1 }, { "type": "number", "minimum": -180, "maximum": 180 }, { "type": "number", "minimum": -90, "maximum": 90 }], "items": false },
    "physicalEdge": { "type": "array", "minItems": 9, "maxItems": 9, "prefixItems": [{ "type": "string", "minLength": 1 }, { "type": "integer", "minimum": 0 }, { "type": "integer", "minimum": 0 }, { "type": "array", "minItems": 2, "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } } }, {}, {}, {}, {}, { "type": "boolean" }], "items": false },
    "directedEdge": { "type": "array", "minItems": 6, "maxItems": 6, "prefixItems": [{ "type": "integer", "minimum": 0 }, { "type": "integer", "minimum": 0 }, { "type": "integer", "minimum": 0 }, { "enum": [0, 1] }, { "type": "number", "exclusiveMinimum": 0 }, { "type": "number", "exclusiveMinimum": 0 }], "items": false }
  }
}
