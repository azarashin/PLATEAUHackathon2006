{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.pit-creation.com/schemas/environment-cost-server-cost-slice-v1.schema.json",
  "title": "Environment cost server cost slice v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "areaId", "timestamp", "topologyContentFingerprintSha256", "environmentCostFingerprintSha256", "physicalEdgeCount", "statusCounts", "costs", "contentFingerprintSha256"],
  "properties": {
    "schemaVersion": { "const": "environment-cost-server-cost-slice-1.0" },
    "areaId": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "topologyContentFingerprintSha256": { "$ref": "#/$defs/sha256" },
    "environmentCostFingerprintSha256": { "$ref": "#/$defs/sha256" },
    "physicalEdgeCount": { "type": "integer", "minimum": 1 },
    "statusCounts": {
      "type": "object", "additionalProperties": false,
      "required": ["available", "partial", "missing"],
      "properties": {
        "available": { "type": "integer", "minimum": 0 },
        "partial": { "type": "integer", "minimum": 0 },
        "missing": { "type": "integer", "minimum": 0 }
      }
    },
    "costs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/cost" } },
    "contentFingerprintSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nullableNumber": { "anyOf": [{ "type": "number" }, { "type": "null" }] },
    "cost": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "prefixItems": [
        { "enum": [0, 1, 2] },
        { "type": "integer", "minimum": 0 },
        { "type": "integer", "minimum": 0 },
        { "type": "integer", "minimum": 0 },
        { "$ref": "#/$defs/nullableNumber" },
        { "$ref": "#/$defs/nullableNumber" }
      ],
      "items": false
    }
  }
}
