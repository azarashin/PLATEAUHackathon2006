{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.pit-creation.com/schemas/route-request-v1.schema.json",
  "title": "Route request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["areaId", "timestamp", "start", "end"],
  "properties": {
    "areaId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "timestamp": { "type": "string", "format": "date-time" },
    "start": { "$ref": "#/$defs/coordinate" },
    "end": { "$ref": "#/$defs/coordinate" },
    "profiles": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "$ref": "#/$defs/profile" } },
    "scenarioId": { "$ref": "#/$defs/scenarioId" }
  },
  "$defs": {
    "coordinate": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "prefixItems": [
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 }
      ],
      "items": false
    },
    "scenarioId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "solarAvoidanceFactor"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
        "solarAvoidanceFactor": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    }
  }
}
